# Copy to .env and fill in the values.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/mansaoferta?schema=public"

# Auth.js — generate with: openssl rand -base64 33
AUTH_SECRET=""
# Set to true when running behind a proxy / in Docker
AUTH_TRUST_HOST=true
# Public base URL of the app
APP_URL="http://localhost:3000"

# Google OAuth (optional — email/password login works without it)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 32-byte key as 64 hex chars — encrypts tenant secrets (MercadoPago token).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Storage driver: "local" (writes to ./uploads) or "s3"
STORAGE_DRIVER="local"

# S3 / Cloudflare R2 / MinIO — only when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves the bucket objects
S3_PUBLIC_URL=""
